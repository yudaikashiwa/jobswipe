# アプリの実行ポート（未使用を想定）
PORT=3055

# Prisma/MySQL
DATABASE_URL="mysql://jobswipe:jobswipe@127.0.0.1:3310/jobswipe"
SHADOW_DATABASE_URL="mysql://root:password@127.0.0.1:3310/jobswipe_shadow"

# Auth.js / NextAuth v5
AUTH_SECRET="replace-with-strong-random-string"
NEXTAUTH_URL="http://localhost:3055"

# メール送信（任意: 設定が無ければコンソールにログ出力）
EMAIL_FROM="JobSwipe <no-reply@example.com>"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-user"
SMTP_PASS="your-pass"
